# NewDoAuto Environment Configuration Template
# DO NOT put actual secret keys, service_role keys, or database passwords in this file.
# Copy this file to .env and fill in with your project details.

# ==============================================================================
# Supabase Configuration (Client-side / Desktop App)
# Note: Use ONLY the public project URL and the publishable / anon public key.
# Row Level Security (RLS) policies on your Supabase tables enforce data ownership.
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Optional: Live Two-User RLS Verification Test Accounts (used only by pytest)
# NEWDOAUTO_TEST_USER_A_EMAIL=user_a@example.com
# NEWDOAUTO_TEST_USER_A_PASSWORD=replace-with-test-password
# NEWDOAUTO_TEST_USER_B_EMAIL=user_b@example.com
# NEWDOAUTO_TEST_USER_B_PASSWORD=replace-with-test-password

# ==============================================================================
# Desktop Application & Execution Settings
# ==============================================================================
NEWDOAUTO_LOG_LEVEL=INFO
NEWDOAUTO_ACTION_TIMEOUT_SECONDS=10
NEWDOAUTO_GLOBAL_TIMEOUT_SECONDS=300
NEWDOAUTO_EMERGENCY_STOP_KEY=F12
